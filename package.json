{
  "name": "blog-2026",
  "version": "0.8.3",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "sync-perf-data": "node --experimental-strip-types scripts/sync-perf-data.ts",
    "build": "next build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
