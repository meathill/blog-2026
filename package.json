    "@next/third-parties": "^16.1.6",
    "@notionhq/client": "^5.9.0",
    "@opennextjs/cloudflare": "^1.16.4",
    "better-auth": "^1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "highlight.js": "^11.11.1",
