{
  "name": "blog-2026",
  "version": "0.8.3",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "sync-perf-data": "node --experimental-strip-types scripts/sync-perf-data.ts",
    "indexnow": "node scripts/indexnow-submit.ts",
    "build": "next build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --strict-vars=false env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote",
    "sync:apps": "npx tsx scripts/sync-apps.ts",
    "seed:products": "node scripts/seed-products.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@blocknote/core": "0.52.1",
    "@blocknote/react": "0.52.1",
    "@blocknote/shadcn": "0.52.1",
    "@google/genai": "^2.13.0",
    "@next/third-parties": "^16.3.4",
    "@opennextjs/cloudflare": "^1.20.4",
    "@tiptap/pm": "^3.28.0",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.566.0",
    "marked": "^18.0.7",
    "meathill-brand": "^0.1.0",
    "meathill-brand-react": "^0.1.0",
    "mermaid": "^11.16.0",
    "next": "^16.3.4",
    "next-intl": "^4.13.4",
    "node-html-parser": "^9.0.0",
    "openai": "^6.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "slugify": "^1.6.9",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  }
}
