{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "blog-2026",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "account_id": "fdc63eeea83ae8f5234357308b9a638b",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  // 官方 ISR 队列的自引用绑定；停用 R2 期间保留既有绑定和迁移历史。
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "blog-2026"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meathill",
      "database_id": "600784c2-db96-4bd6-be22-d2e2375bcef7"
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "tag-cache",
      "database_id": "5f26868d-5d24-4645-8954-a27168f6fcd6"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  // observability 本月额度已用完，暂时关闭以节省 Workers 请求数；需要排障时再手动打开。
  "observability": {
    "enabled": false
  },
  // 官方 Workers Cache：命中时不执行 Worker，遵循 Next/OpenNext 的响应缓存头。
  "cache": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "blog"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PERF_KV",
      "id": "212d31a7fa4945939e9e851f292ac5c8",
      "preview_id": "212d31a7fa4945939e9e851f292ac5c8"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://meathill.com",
    "NEXT_PUBLIC_ASSETS_URL": "https://i.meathill.com",
    "NEXT_PUBLIC_GOOGLE_ADSENSE_ID": "ca-pub-9946806099979342",
    "NEXT_PUBLIC_GOOGLE_ANALYTICS_ID": "G-1S0T1HF97B",
    "NEXT_PUBLIC_SEARCH_API_URL": "https://mui-search.meathill.com",
    "AI_MODEL": "gpt-5.6-luna",
    "BETTER_AUTH_BASE_URL": "https://meathill.com",
    "CRON_SECRET": "meathill-2026",
    "WORDPRESS_API_URL": "https://blog.meathill.com/wp-json/wp/v2",
    "CF_ZONE_ID": "4fcd4be90a03cfd52b317514268d9cf4"
  },
  "secrets": {
    "required": [
      "CF_ACCESS_CLIENT_ID",
      "CF_ACCESS_CLIENT_SECRET",
      "BETTER_AUTH_SECRET",
      "MCP_TOKEN",
      "WP_USERNAME",
      "WP_APP_PASSWORD"
    ]
  }
}
