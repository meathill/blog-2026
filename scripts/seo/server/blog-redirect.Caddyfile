# blog.meathill.com origin（Cloudflare Tunnel -> Caddy :8080 -> PHP-FPM -> WordPress）
# Issue #4：退役旧 sitemap + 把历史公开 URL 收敛到 meathill.com。
# ⚠️ 保留 /wp-json /wp-admin /wp-content 等，meathill.com 的 API/媒体依赖它们。
# 安装：备份原 Caddyfile -> caddy validate -> 覆盖 -> systemctl restart caddy -> 验证 /wp-json 仍 200。
# ⚠️ 本机 Caddyfile 含 `admin off`，`caddy reload`/`systemctl reload` 不可用（无 admin API），
#    必须用 `systemctl restart caddy`（ExecStart 直接读本文件）。回滚：cp 备份 + restart。
# 备注：blog.meathill.com 经 Cloudflare Tunnel 接入，Cloudflare 边缘已有 blog->meathill 跳转，
#    本 origin 规则为纵深防御 + sitemap 410 + 保住 API/媒体。

{
	auto_https off
	admin off
}

:8080 {
	bind 127.0.0.1
	root * /var/www/blog
	encode gzip zstd

	# 1) 保留：WP API / 后台 / 媒体 / cron / 验证目录（meathill.com 依赖，原样交给 PHP/文件服务）
	@preserve path /wp-json* /wp-admin* /wp-login.php /wp-cron.php /xmlrpc.php /wp-content* /wp-includes* /.well-known*
	handle @preserve {
		php_fastcgi unix//run/php/php8.5-fpm.sock
		file_server
	}

	# 2) 旧 sitemap（Jetpack 生成）-> 410，让 Google 彻底放弃
	@oldsitemap path_regexp ^/.*sitemap.*\.xml$
	handle @oldsitemap {
		respond 410
	}

	# 3) 真实存在的静态文件（站点验证 html/txt、ads.txt、图片等）原样服务；
	#    要求“文件存在”且为静态后缀，避免把 .php 当静态泄露、也不会误伤虚拟文章 URL。
	@staticfile {
		file
		path *.html *.htm *.txt *.xml *.json *.jpg *.jpeg *.png *.gif *.webp *.svg *.ico *.css *.js *.pdf *.xsl *.woff *.woff2
	}
	handle @staticfile {
		file_server
	}

	# 4) .html 文章（虚拟永久链接）-> meathill 规范页（Next.js 再 301 补全分类）
	@html path_regexp html ^/(.+)\.html$
	handle @html {
		redir https://meathill.com/posts/{re.html.1} 301
	}

	# 5) 分类 / 标签 / 作者归档
	@category path /category/*
	handle @category {
		redir https://meathill.com{uri} 301
	}
	@tag path /tag/*
	handle @tag {
		redir https://meathill.com{uri} 301
	}
	@author path_regexp author ^/author/(.*)$
	handle @author {
		redir https://meathill.com/posts/author/{re.author.1} 301
	}

	# 6) 其余公开路径兜底 -> meathill 首页
	handle {
		redir https://meathill.com/ 301
	}
}
