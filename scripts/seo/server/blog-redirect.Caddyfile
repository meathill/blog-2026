# blog.meathill.com origin（Cloudflare Tunnel -> Caddy :8080 -> PHP-FPM -> WordPress）
# Issue #4：退役旧 sitemap + 把历史公开 URL 收敛到 meathill.com。
# 2026-06-11（TiDB 降载）：@preserve 拆三块——
#   1a) /wp-content /wp-includes 纯静态：缺失文件直接 Caddy 404，不再经 php_fastcgi
#       try_files 回落 index.php 启动全量 WP 打 DB（bot 探测缺失文件曾导致 15s 超时请求）。
#   1c) feed 路径走 PHP：meathill.com 的 RSS 代理（/feed/、/tag/x/feed/）回源依赖，
#       必须排在 @category/@tag/@author 重定向之前（handle 按出现顺序首个命中生效）。
# ⚠️ 保留 /wp-json /wp-content 等，meathill.com 的 API/媒体依赖它们。
# 2026-07-16（Application Passwords 401 修复）：两处 php_fastcgi 都加 env HTTPS on / env
#   HTTP_X_FORWARDED_PROTO https——Caddy 本身 auto_https off + 纯 HTTP 监听，php_fastcgi 按自己的
#   连接状态派生这两个 FastCGI 参数（header_up 试过，改不动，Caddy 对 X-Forwarded-* 有自己的覆盖逻辑，
#   不管 Cloudflare Tunnel 传的是什么，PHP 收到的永远是 http），导致 is_ssl() 恒为 false，WordPress
#   核心据此把 Application Passwords 整体关掉（发布用的 Basic Auth 一律 401 rest_not_logged_in）。
#   用 env 直接覆盖 FastCGI 参数才生效；写死 https 是准确的：本监听只有本机 Cloudflare Tunnel 能连，
#   且该域名边缘只服务 HTTPS。
# 安装：备份原 Caddyfile -> caddy validate -> 覆盖 -> systemctl restart caddy -> 验证 /wp-json 仍 200。
# ⚠️ 本机 Caddyfile 含 `admin off`，`caddy reload`/`systemctl reload` 不可用（无 admin API），
#    必须用 `systemctl restart caddy`（ExecStart 直接读本文件）。回滚：cp 备份 + restart。
# 备注：blog.meathill.com 经 Cloudflare Tunnel 接入，Cloudflare 边缘已有 blog->meathill 跳转，
#    本 origin 规则为纵深防御 + sitemap 410 + 保住 API/媒体。

{
	auto_https off
	admin off
}

:8080 {
	bind 127.0.0.1
	root * /var/www/blog
	encode gzip zstd

	# 访问日志:排查「什么在打 PHP/DB」的一手证据(JSON,自动滚动)
	log {
		output file /var/log/caddy/blog-access.log {
			roll_size 50MiB
			roll_keep 3
		}
		format json
	}

	# 1a) 纯静态：wp-content / wp-includes —— 零 PHP，缺失文件直接 404（TiDB 止血）
	@assets path /wp-content/* /wp-includes/*
	handle @assets {
		file_server
	}

	# 1b) PHP 保留：WP API / 后台 / cron / 验证目录（meathill.com 依赖，原样交给 PHP/文件服务）
	@preserve path /wp-json* /wp-admin* /wp-login.php /wp-cron.php /xmlrpc.php /.well-known*
	handle @preserve {
		php_fastcgi unix//run/php/php8.5-fpm.sock {
			env HTTPS on
			env HTTP_X_FORWARDED_PROTO https
		}
		file_server
	}

	# 1c-1) 带斜杠的 feed:由 Caddy 直接 301 到无斜杠规范 URL(带 https)。
	#       不能交给 WP canonical——origin 不知道自己在 https 后面,会发
	#       Location: http://...,Worker fetch 跟随会失败
	@feedslash path_regexp feedslash ^(/(.+/)?feed)/$
	handle @feedslash {
		redir https://blog.meathill.com{re.feedslash.1} 301
	}

	# 1c-2) 无斜杠 feed(/feed、/tag/x/feed、/comments/feed):WP 的规范形态,直接输出 RSS
	@feed path_regexp feed ^/(.+/)?feed$
	handle @feed {
		php_fastcgi unix//run/php/php8.5-fpm.sock {
			env HTTPS on
			env HTTP_X_FORWARDED_PROTO https
		}
	}

	# 2) 旧 sitemap（Jetpack 生成）-> 410，让 Google 彻底放弃
	@oldsitemap path_regexp ^/.*sitemap.*\.xml$
	handle @oldsitemap {
		respond 410
	}

	# 3) 真实存在的静态文件（站点验证 html/txt、ads.txt、图片等）原样服务；
	#    要求“文件存在”且为静态后缀，避免把 .php 当静态泄露、也不会误伤虚拟文章 URL。
	@staticfile {
		file
		path *.html *.htm *.txt *.xml *.json *.jpg *.jpeg *.png *.gif *.webp *.svg *.ico *.css *.js *.pdf *.xsl *.woff *.woff2
	}
	handle @staticfile {
		file_server
	}

	# 4a) 旧 WP 附件页：/path/post.html/attachment/xxx -> 父文（勿落到首页兜底）
	#     `.html$` 匹配不到中间带 /attachment 的路径，必须单独处理（issue #4）
	@attachment path_regexp attachment ^/(.+)\.html/attachment(/.*)?$
	handle @attachment {
		redir https://meathill.com/posts/{re.attachment.1} 301
	}

	# 4b) .html 文章（虚拟永久链接）-> meathill 规范页（Next.js 再 301 补全分类）
	@html path_regexp html ^/(.+)\.html$
	handle @html {
		redir https://meathill.com/posts/{re.html.1} 301
	}

	# 5) 分类 / 标签 / 作者归档
	@category path /category/*
	handle @category {
		redir https://meathill.com{uri} 301
	}
	@tag path /tag/*
	handle @tag {
		redir https://meathill.com{uri} 301
	}
	@author path_regexp author ^/author/(.*)$
	handle @author {
		redir https://meathill.com/posts/author/{re.author.1} 301
	}

	# 6) 其余公开路径兜底 -> meathill 首页
	handle {
		redir https://meathill.com/ 301
	}
}
